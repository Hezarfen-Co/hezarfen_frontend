# hezarfen_frontend.env — production knobs for the podman compose stack.
#
# One-time setup ON THE SERVER, by hand:
#   mkdir -p ~/hezarfen_frontend
#   cp hezarfen_frontend.env.example ~/hezarfen_frontend/hezarfen_frontend.env
#   <fill in the values you are changing>
#   chmod 0600 ~/hezarfen_frontend/hezarfen_frontend.env
#
# Nothing automated creates, overwrites or uploads this file — the operator
# owns it; compose only reads it (`podman compose --env-file`, plus `env_file`
# into the frontend container). Plain KEY=value lines: no quotes, no `export`.
#
# One file, two readers: `--env-file` feeds compose's ${VAR:-default}
# interpolation in compose.yaml, and `env_file:` passes the same file into the
# container. keys compose.yaml lists under `environment:` always win over
# `env_file:` — BACKEND_ORIGIN is one of them, and it takes effect through the
# interpolation, not through the container environment.
#
# The app reads exactly two keys today (server.ts): BACKEND_ORIGIN and PORT.
# Any other key here is carried into the container untouched, unread.

# ── Backend origin ───────────────────────────────────────────────────────────
# Where the container proxies /api/* — plain HTTP and the exam-room WebSocket
# alike. The browser only ever talks to this frontend, so session cookies stay
# same-origin. Must be reachable FROM INSIDE the container.
#
# The default below is the public origin and always works. A
# container-to-container origin such as http://hezarfen_backend:7656 is NOT
# wired today: neither compose stack declares a shared podman network, and the
# backend publishes on host loopback only (127.0.0.1:7656).
BACKEND_ORIGIN=https://hezarfen.dizey.sh

# ── Listen port ──────────────────────────────────────────────────────────────
# One value moves three things: what server.ts listens on, the host-loopback
# publish (127.0.0.1:<PORT>:<PORT> in compose.yaml) and the deploy's health
# gate, which reads this line back out of this file. Leave it at 5173 unless
# something else already owns that port on the server.
PORT=5173

# ── Image tag ────────────────────────────────────────────────────────────────
# NOT read from here: HEZARFEN_TAG is compose interpolation only and travels in
# the deploy-owned stack.env (the second `--env-file`, which wins for duplicate
# keys). The systemd unit starts with `--no-build`, so the image must already
# exist on the host before the first start:
#   podman compose build          # build it here
#   podman load -i image.tar      # or load one shipped from elsewhere
#HEZARFEN_TAG=latest
